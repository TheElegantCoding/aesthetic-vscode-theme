{
  "publisher": "LuisMonsalve",
  "name": "aesthetic-vscode-theme",
  "displayName": "Aesthetic Theme",
  "description": "A minimal, aesthetic dark theme crafted for a clean coding experience.",
  "author": "Luis Monsalve",
  "license": "MIT",
  "version": "1.0.1",
  "private": true,
  "homepage": "https://github.com/TheElegantCoding/aesthetic-theme#readme",
  "repository": {
    "type": "git",
    "url": "https://github.com/TheElegantCoding/aesthetic-theme"
  },
  "keywords": [
    "vscode",
    "vscode-extension",
    "theme",
    "visual-studio-code",
    "vsc-theme"
  ],
  "categories": ["Themes"],
  "bugs": {
    "url": "https://github.com/TheElegantCoding/aesthetic-theme/issues"
  },
  "type": "module",
  "icon": "icon.png",
  "engines": {
    "vscode": "^1.125.0",
    "node": ">=22.17.0",
    "bun": ">=1.1.0"
  },
  "contributes": {
    "themes": [{
      "label": "Aesthetic theme dark grey",
      "uiTheme": "vs-dark",
      "path": "./dist/aesthetic-dark-grey.json"
    }, {
      "label": "Aesthetic theme",
      "uiTheme": "vs-dark",
      "path": "./dist/aesthetic-dark.json"
    }]
  },
  "scripts": {
    "postinstall": "bunx gitlys init",
    "preinstall": "npx only-allow bun",
    "typecheck": "tsc --noEmit",
    "release": "bun run build && bunx gitlys release && bun run package && bun run publish",
    "lint": "eslint . --fix --cache",
    "type-check": "tsc --noEmit",
    "build": "bun run lint && bun run type-check && bun src/global/util/generate_theme.ts",
    "watch": "bun --hot src/global/util/generate_theme.ts",
    "package": "vsce package --no-dependencies",
    "publish": "vsce publish --no-dependencies"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "eslint-config-universal-code": "1.1.4",
    "gitlys": "2.2.3",
    "tsup": "8.5.1",
    "typescript": "5.2.2"
  }
}